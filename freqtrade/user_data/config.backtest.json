{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "dry_run": true,
  "dry_run_wallet": 105,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 1.0,
  "max_open_trades": 2,
  "timeframe": "1h",
  "fee": 0.0006,
  "futures_funding_rate": 0.0001,
  "dataformat_ohlcv": "feather",
  "datadir": "/freqtrade/user_data/data/bitget",
  "exchange": {
    "name": "bitget",
    "ccxt_config": {
      "enableRateLimit": true,
      "rateLimit": 350,
      "options": {
        "uta": false
      }
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "rateLimit": 350,
      "options": {
        "uta": false
      }
    },
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "SOL/USDT:USDT",
      "XRP/USDT:USDT",
      "NEAR/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "order_types": {
    "entry": "market",
    "exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": false
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": false
  },
  "spike": {
    "entry_start": "2022-10-01T00:00:00+00:00",
    "note": "Research only. Entries before entry_start are suppressed so 2022 serves as indicator warmup."
  }
}